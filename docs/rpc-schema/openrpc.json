    },
    "ToolCallRecordWire": {
      "$defs": {
        "ToolCallOutcomeWire": {
          "description": "Wire-format tool call outcome.",
          "properties": {
            "kind": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      },
      "description": "Wire-format tool call record.",
      "properties": {
        "arguments": {
          "type": "string"
        },
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
