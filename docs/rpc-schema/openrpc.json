    "ToolEntry": {
      "description": "A single tool entry in `listTools`.",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": true,
        "risk": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "risk",
        "parameters"
      ],
      "type": "object"
    },
    "UsageContextWire": {
      "description": "Wire-format live context snapshot (nested inside the `usage` notification).",
      "properties": {
        "completionReserve": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contextWindow": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "estimatedUsed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "utilizationPercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
