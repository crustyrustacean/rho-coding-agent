    },
    "SessionEntry": {
      "description": "A single session entry in `listSessions`.",
      "properties": {
        "entryCount": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mtimeSecs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "sizeKb": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "mtimeSecs",
        "sizeKb",
        "entryCount"
      ],
      "type": "object"
    },
    "TokenUsageWire": {
      "description": "Wire-format token usage (delta for a single `run_loop` call).",
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
