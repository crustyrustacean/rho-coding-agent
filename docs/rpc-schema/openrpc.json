{
  "$defs": {
    "ApiUsageWire": {
      "description": "Wire-format API usage (nested inside `getSessionStats`).",
      "properties": {
        "requestCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "totalCachedTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalCost": {
          "format": "double",
          "type": "number"
        },
        "totalInputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalOutputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
