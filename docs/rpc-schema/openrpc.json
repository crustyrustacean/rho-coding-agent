        "contextWindow",
        "completionReserve",
        "utilizationPercent"
      ],
      "type": "object"
    },
    "UsageDeltaWire": {
      "description": "Wire-format per-iteration usage delta (nested inside the `usage` notification).",
      "properties": {
        "cachedTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cost": {
          "format": "double",
          "type": "number"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requestCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cachedTokens",
        "cost",
        "requestCount"
      ],
      "type": "object"
    }
  },
  "info": {
    "description": "Headless coding agent — JSON-RPC 2.0 protocol over stdin/stdout. Diagnostic output goes to stderr.",
    "title": "rho",
    "version": "0.92.0"
  },
  "methods": [
    {
      "description": "Send a user message to the agent. The agent runs its loop (send to model → tool calls → approval → execution → repeat) until it produces a text reply or exhausts a budget.",
      "name": "prompt",
      "params": [
        {
          "description": "The user's message text.",
          "name": "message",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Mid-turn steering nudge.\n\nWhen `true`, the message is queued and injected at the next tool-batch\nseam (just before the following LLM call) instead of starting a new\nturn — matching pi's `streamingBehavior: \"steer\"`. Defaults to `false`\nso existing `prompt` payloads are unaffected.",
          "name": "steer",
          "required": false,
          "schema": {
            "default": false,
            "type": "boolean"
          }
        }
      ],
      "result": {
        "description": "Result for `prompt` — the agent's reply text.",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "reply": {
              "type": "string"
            }
          },
          "required": [
            "reply"
          ],
          "title": "PromptResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Cancel the in-progress turn, if any. Returns an empty acknowledgement; observe `agent/end` (finishReason `cancelled`) or `agent/error` for the outcome.",
      "name": "abort",
      "params": [],
      "result": {
        "description": "Empty result for methods that return no data (`abort`, `clear`, `compact`,\n`reloadExtensions`).",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "EmptyResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Clear conversation history: branch the session tree back to the root entry so prior turns remain on disk but leave the active path.",
      "name": "clear",
      "params": [],
      "result": {
        "description": "Empty result for methods that return no data (`abort`, `clear`, `compact`,\n`reloadExtensions`).",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "EmptyResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Start a fresh session, preserving model, provider, tools, token budget, and redactor settings.",
      "name": "newSession",
      "params": [],
      "result": {
        "description": "Result for `newSession`.",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "path": {
              "description": "Path to the new session's JSONL file (empty for in-memory sessions).",
              "type": "string"
            },
            "sessionId": {
              "description": "The new session's unique id.",
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "path"
          ],
          "title": "NewSessionResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Trigger context compaction now, regardless of the auto-compact threshold. Summarizes older entries to free context.",
      "name": "compact",
      "params": [],
      "result": {
        "description": "Empty result for methods that return no data (`abort`, `clear`, `compact`,\n`reloadExtensions`).",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "EmptyResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Return the active model, provider, working directory, and message count.",
      "name": "getState",
      "params": [],
      "result": {
        "description": "Result for `getState`.",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "cwd": {
              "type": "string"
            },
            "messageCount": {
              "default": 0,
              "description": "Number of conversation messages on the active path.\n\nDuplicates `getSessionStats.messageCount` so a frontend can render a\nbanner with one round trip. Additive (`#[serde(default)]`); streaming\nstate is NOT here — it's event-driven (`agent/start` + `agent/end`),\nsince `getState` is processed serially and can't observe a turn\nmid-flight.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "provider",
            "cwd"
          ],
          "title": "GetStateResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Return all conversation messages on the active session path.",
      "name": "getMessages",
      "params": [],
      "result": {
        "description": "Result for `getMessages`. Messages are pre-serialized `Value`s because\nthe `ChatMessage` → JSON conversion has complex per-role shapes that\ndon't map cleanly to a single struct without coupling `rho-core` to the\nwire format.",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "messages": {
              "items": true,
              "type": "array"
            }
          },
          "required": [
            "messages"
          ],
          "title": "GetMessagesResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Switch the active model by id or `provider:id`. On a bare id, each provider is probed to find who serves it.",
      "name": "setModel",
      "params": [
        {
          "description": "",
          "name": "model",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "description": "Result for `setModel`.\n\nBeyond the resolved model/provider, carries the post-switch context-window\nstats so clients can refresh their footer in the same round-trip (no\nseparate `getSessionStats` needed just to reflect the new model's window).",
        "name": "result",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "contextWindow": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "estimatedUsed": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "utilizationPercent": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "model",
            "provider",
            "contextWindow",
            "estimatedUsed",
            "utilizationPercent"
          ],
          "title": "SetModelResult",
          "type": "object"
        }
      }
    },
    {
      "description": "List available models from all configured providers.",
      "name": "listModels",
      "params": [],
      "result": {
        "description": "Result for `listModels`.",
        "name": "result",
        "schema": {
          "$defs": {
            "ModelEntry": {
              "description": "A single model entry in `listModels`.",
              "properties": {
                "id": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "provider"
              ],
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "models": {
              "items": {
                "$ref": "#/$defs/ModelEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "models"
          ],
          "title": "ListModelsResult",
          "type": "object"
        }
      }
    },
    {
      "description": "List configured providers with local/remote and reachability status.",
      "name": "listProviders",
      "params": [],
      "result": {
        "description": "Result for `listProviders`.",
        "name": "result",
        "schema": {
          "$defs": {
            "ProviderEntry": {
              "description": "A single provider entry in `listProviders`.",
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "isExternal": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "reachable": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "isExternal",
                "reachable",
                "active"
              ],
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "providers": {
              "items": {
                "$ref": "#/$defs/ProviderEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "providers"
          ],
          "title": "ListProvidersResult",
          "type": "object"
        }
      }
    },
    {
      "description": "Return context-window budget and token-distribution stats.",
      "name": "getSessionStats",
      "params": [],
      "result": {
        "description": "Result for `getSessionStats`.",
        "name": "result",
