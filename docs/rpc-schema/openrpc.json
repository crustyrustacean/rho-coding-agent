        },
        "outlined": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pinned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "summarized": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
