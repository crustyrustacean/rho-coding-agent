{
  "info": {
    "description": "Headless coding agent — JSON-RPC 2.0 protocol over stdin/stdout. Diagnostic output goes to stderr.",
    "title": "rho",
    "version": "0.91.1"
  },
  "methods": [
    {
      "description": "Send a user message to the agent. The agent runs its loop (send to model → tool calls → approval → execution → repeat) until it produces a text reply or exhausts a budget.",
      "name": "prompt",
      "params": [
        {
          "description": "The user's message to the agent.",
          "name": "message",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "When true, the message is queued as a mid-turn steering nudge and injected at the next tool-batch seam instead of starting a new turn. Defaults to false.",
          "name": "steer",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "description": "The agent's reply on success, or an error object on failure.",
        "name": "result",
        "schema": {
          "oneOf": [
            {
              "description": "Success: the agent's text reply.",
              "properties": {
                "reply": {
                  "type": "string"
                }
              },
              "required": [
                "reply"
              ],
              "type": "object"
            },
            {
              "description": "Error: the agent loop failed.",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "description": "Cancel the current operation. If the agent is running, the current model request is cancelled at the next checkpoint.",
      "name": "abort",
      "params": [],
      "result": {
        "description": "Empty acknowledgement.",
        "name": "result",
        "schema": {
          "properties": {},
          "type": "object"
        }
      }
    },
    {
      "description": "Clear conversation history by branching back to the system message.",
      "name": "clear",
      "params": [],
      "result": {
        "description": "Empty acknowledgement.",
        "name": "result",
        "schema": {
          "properties": {},
          "type": "object"
        }
      }
    },
    {
      "description": "Start a fresh session, preserving the current model, provider, tools, and token budget. Unlike clear (which branches back to the root of the existing tree), this begins a brand-new conversation: a new JSONL file for persisted sessions, or a fresh in-memory tree otherwise.",
      "name": "newSession",
      "params": [],
      "result": {
        "description": "New session info.",
        "name": "result",
        "schema": {
          "properties": {
            "path": {
              "description": "Path to the new session's JSONL file (empty for in-memory sessions).",
              "type": "string"
            },
            "sessionId": {
              "description": "The new session's unique id.",
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "path"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Trigger context compaction to free space in the context window.",
      "name": "compact",
      "params": [],
      "result": {
        "description": "Empty acknowledgement.",
        "name": "result",
        "schema": {
          "properties": {},
          "type": "object"
        }
      }
    },
    {
      "description": "Return the current model, provider name, and working directory.",
      "name": "getState",
      "params": [],
      "result": {
        "description": "Current agent state.",
        "name": "result",
        "schema": {
          "properties": {
            "cwd": {
              "description": "Current working directory.",
              "type": "string"
            },
            "messageCount": {
              "description": "Number of conversation messages on the active path. Additive; not present in older versions.",
              "type": "integer"
            },
            "model": {
              "description": "Active model identifier.",
              "type": "string"
            },
            "provider": {
              "description": "Active provider name.",
              "type": "string"
            }
          },
          "required": [
            "model",
            "provider",
            "cwd"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Return all messages on the active conversation path.",
      "name": "getMessages",
      "params": [],
      "result": {
        "description": "Serialized conversation messages.",
        "name": "result",
        "schema": {
          "properties": {
            "messages": {
              "description": "Array of ChatMessage objects with role-specific shapes.",
              "items": {
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "messages"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Switch the active model (and its provider). Accepts a bare model ID or a 'provider:id' specifier.",
      "name": "setModel",
      "params": [
        {
          "description": "Model identifier (bare ID or provider:id).",
          "name": "model",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "description": "The new active model and provider.",
        "name": "result",
        "schema": {
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "provider"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "List available models from all configured providers.",
      "name": "listModels",
      "params": [],
      "result": {
        "description": "Available models.",
        "name": "result",
        "schema": {
          "properties": {
            "models": {
              "items": {
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "provider"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "models"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "List configured providers with reachability status.",
      "name": "listProviders",
      "params": [],
      "result": {
        "description": "Configured providers.",
        "name": "result",
        "schema": {
          "properties": {
            "providers": {
              "items": {
                "properties": {
                  "active": {
                    "description": "Whether this is the currently active provider.",
                    "type": "boolean"
                  },
                  "isExternal": {
                    "description": "Whether the provider is an external (non-local) endpoint.",
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "reachable": {
                    "description": "Whether the provider endpoint is reachable.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "isExternal",
                  "reachable",
                  "active"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "providers"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Return token budget, context window usage, and API cost statistics.",
      "name": "getSessionStats",
      "params": [],
      "result": {
        "description": "Session statistics.",
        "name": "result",
        "schema": {
          "properties": {
            "apiUsage": {
              "description": "Cumulative API usage across all requests.",
              "properties": {
                "requestCount": {
                  "type": "integer"
                },
                "totalCachedTokens": {
                  "description": "Input tokens served from a prompt cache (subset of totalInputTokens).",
                  "type": "integer"
                },
                "totalCost": {
                  "description": "Cumulative cost in USD.",
                  "type": "number"
                },
                "totalInputTokens": {
                  "type": "integer"
                },
                "totalOutputTokens": {
                  "type": "integer"
                },
                "totalTokens": {
                  "type": "integer"
                }
              },
              "required": [
                "totalInputTokens",
                "totalOutputTokens",
                "totalCachedTokens",
                "totalTokens",
                "totalCost",
                "requestCount"
              ],
              "type": "object"
            },
            "compactedEntryCount": {
              "description": "Entries that have been compacted.",
              "type": "integer"
            },
            "compactionTokens": {
              "description": "Tokens used by compacted summaries.",
              "type": "integer"
            },
            "completionReserve": {
              "description": "Tokens reserved for model completion output.",
              "type": "integer"
            },
            "contextWindow": {
              "description": "Total context window size in tokens.",
              "type": "integer"
            },
            "entryCount": {
              "description": "Total session entries.",
              "type": "integer"
            },
            "estimatedRemaining": {
              "description": "Estimated tokens remaining before compaction.",
              "type": "integer"
            },
            "estimatedUsed": {
              "description": "Estimated tokens used in the context.",
              "type": "integer"
            },
            "messageCount": {
              "description": "Number of messages in the context.",
              "type": "integer"
            },
            "pathEntryCount": {
              "description": "Entries on the active path.",
              "type": "integer"
            },
            "phaseTokens": {
              "description": "Token counts by session phase. All buckets are zero until the session has classified entries into phases.",
              "properties": {
                "conclusion": {
                  "type": "integer"
                },
                "execution": {
                  "type": "integer"
                },
                "exploration": {
                  "type": "integer"
                },
                "unclassified": {
                  "type": "integer"
                },
                "verification": {
                  "type": "integer"
                }
              },
              "required": [
                "exploration",
                "execution",
                "verification",
                "conclusion",
                "unclassified"
              ],
              "type": "object"
            },
            "resolutionTokens": {
              "description": "Token counts by entry resolution level.",
              "properties": {
                "full": {
                  "type": "integer"
                },
                "outlined": {
                  "type": "integer"
                },
                "pinned": {
                  "type": "integer"
                },
                "summarized": {
                  "type": "integer"
                }
              },
              "required": [
                "full",
                "outlined",
                "summarized",
                "pinned"
              ],
              "type": "object"
            },
            "roleTokens": {
              "description": "Token counts by message role.",
              "properties": {
                "assistant": {
                  "type": "integer"
                },
                "system": {
                  "type": "integer"
                },
                "tool": {
                  "type": "integer"
                },
                "user": {
                  "type": "integer"
                }
              },
              "required": [
                "system",
                "user",
                "assistant",
                "tool"
              ],
              "type": "object"
            },
            "utilizationPercent": {
              "description": "Context utilization as a percentage (0-100).",
              "type": "integer"
            }
          },
          "required": [
            "contextWindow",
            "completionReserve",
            "estimatedUsed",
            "estimatedRemaining",
            "utilizationPercent",
            "messageCount",
            "entryCount",
            "pathEntryCount",
            "compactedEntryCount",
            "compactionTokens",
            "roleTokens",
            "resolutionTokens",
            "phaseTokens",
            "apiUsage"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "List previous sessions for the current project.",
      "name": "listSessions",
      "params": [],
      "result": {
        "description": "Available sessions.",
        "name": "result",
        "schema": {
          "properties": {
            "sessions": {
              "items": {
                "properties": {
                  "entryCount": {
                    "description": "Number of entries in the session.",
                    "type": "integer"
                  },
                  "mtimeSecs": {
                    "description": "Modification time as Unix epoch seconds.",
                    "type": "integer"
                  },
                  "path": {
                    "description": "File path to the session JSONL.",
                    "type": "string"
                  },
                  "sizeKb": {
                    "description": "File size in kilobytes.",
                    "type": "integer"
                  }
                },
                "required": [
                  "path",
                  "mtimeSecs",
                  "sizeKb",
                  "entryCount"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "sessions"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "List loaded extensions and their registered tools.",
      "name": "listExtensions",
      "params": [],
      "result": {
        "description": "Loaded extensions.",
        "name": "result",
        "schema": {
          "properties": {
            "extensions": {
              "items": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tools": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "name",
                  "tools"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "extensions"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Reload extensions from disk (mtime-based change detection).",
      "name": "reloadExtensions",
      "params": [],
      "result": {
        "description": "Reload report.",
        "name": "result",
        "schema": {
          "properties": {
            "added": {
              "description": "Number of extensions added.",
              "type": "integer"
            },
            "failed": {
              "description": "Number of extensions that failed to reload.",
              "type": "integer"
            },
            "reloaded": {
              "description": "Number of extensions reloaded.",
              "type": "integer"
            },
            "removed": {
              "description": "Number of extensions removed.",
              "type": "integer"
            }
          },
          "required": [
            "added",
            "reloaded",
            "removed",
            "failed"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Resume a previous session from a JSONL file path. Replaces the current session, restoring model, tools, and token budget from the current app configuration.",
      "name": "resumeSession",
      "params": [
        {
          "description": "Path to the session JSONL file.",
          "name": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "description": "Resumed session info.",
        "name": "result",
        "schema": {
          "properties": {
            "cwd": {
              "type": "string"
            },
            "entryCount": {
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "model",
            "cwd",
            "entryCount"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "List all registered tools with their names, descriptions, risk levels, and parameter schemas.",
      "name": "listTools",
      "params": [],
      "result": {
        "description": "Registered tools.",
        "name": "result",
        "schema": {
          "properties": {
            "tools": {
              "items": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "parameters": {
                    "description": "JSON Schema object for tool parameters.",
                    "type": "object"
                  },
                  "risk": {
                    "description": "Risk level: read, write, destructive, or network.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "description",
                  "risk",
                  "parameters"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "tools"
          ],
          "type": "object"
        }
      }
    },
    {
      "description": "Respond to an approval/request notification. Handled synchronously during the approval flow; if received outside the flow, acknowledged as a no-op.",
      "name": "approvalResponse",
      "params": [
        {
          "description": "Whether to approve the tool call.",
          "name": "approved",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "description": "Optional redirect message. When approved is false and this is present, the agent treats it as a redirect — the user's alternative instructions are injected as a new conversation turn.",
          "name": "message",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "description": "Empty acknowledgement.",
        "name": "result",
        "schema": {
          "properties": {},
          "type": "object"
        }
      }
    }
  ],
  "notifications": [
    {
      "description": "Startup handshake. Emitted once after rho finishes initialization (config loaded, model detected, extensions loaded). The frontend should wait for this before sending any requests.",
      "name": "ready",
      "params": []
    },
    {
      "description": "Agent began processing a prompt.",
      "name": "agent/start",
      "params": []
    },
    {
      "description": "Per-iteration usage tick. Emitted after each model response is routed (once per iteration that hit the model), carrying the per-iteration token/cost delta and a live context snapshot. Frontends can render a context/cost gauge during long multi-iteration turns from this alone, without polling getSessionStats.",
      "name": "usage",
      "params": [
        {
          "name": "iteration",
          "required": true,
          "schema": {
            "description": "1-based iteration index within the current turn.",
            "type": "integer"
          }
        },
        {
          "name": "usage",
          "required": true,
          "schema": {
            "description": "Per-iteration delta (aggregates any retries within the iteration).",
            "properties": {
              "cachedTokens": {
                "description": "Input tokens served from a prompt cache (subset of inputTokens).",
                "type": "integer"
              },
              "cost": {
                "description": "Cost in USD for this iteration. 0 when no pricing applied (unknown model / sentinel pricing).",
                "type": "number"
              },
              "inputTokens": {
                "type": "integer"
              },
              "outputTokens": {
                "type": "integer"
              },
              "requestCount": {
                "description": "LLM requests this iteration (>=1; >1 if retried).",
                "type": "integer"
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "cachedTokens",
              "cost",
              "requestCount"
            ],
            "type": "object"
          }
        },
        {
          "name": "context",
          "required": true,
          "schema": {
            "description": "Live context snapshot after this iteration's model response.",
            "properties": {
              "completionReserve": {
                "type": "integer"
              },
              "contextWindow": {
                "type": "integer"
              },
              "estimatedUsed": {
                "type": "integer"
              },
              "utilizationPercent": {
                "description": "Context utilization (0-100) against the prompt budget (contextWindow - completionReserve).",
                "type": "integer"
              }
            },
            "required": [
              "estimatedUsed",
              "contextWindow",
              "completionReserve",
              "utilizationPercent"
            ],
            "type": "object"
          }
        }
      ]
    },
    {
      "description": "Agent finished processing. Emitted with full structured result from the agent loop.",
      "name": "agent/end",
      "params": [
        {
          "description": "The agent's final text reply.",
          "name": "reply",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Number of agent loop iterations.",
          "name": "iterations",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Cumulative token usage for this run.",
          "name": "usage",
          "required": true,
          "schema": {
            "properties": {
              "inputTokens": {
                "type": "integer"
              },
              "outputTokens": {
                "type": "integer"
              },
              "requestCount": {
                "type": "integer"
              },
              "totalCost": {
                "type": "number"
              },
              "totalTokens": {
                "type": "integer"
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "totalTokens",
              "totalCost",
              "requestCount"
            ],
            "type": "object"
          }
        },
        {
          "description": "Ordered list of tool calls made during this run.",
          "name": "toolCalls",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "arguments": {
                  "type": "string"
                },
                "durationMs": {
                  "description": "Execution duration in milliseconds, omitted if not measured.",
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "outcome": {
                  "properties": {
                    "kind": {
                      "description": "One of: success, error, denied, blocked.",
                      "type": "string"
                    },
                    "output": {
                      "description": "Error or block reason text. Present only for error and blocked outcomes; omitted otherwise.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "name",
                "arguments",
                "outcome"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        {
          "description": "Total wall-clock duration of the agent run in milliseconds.",
          "name": "durationMs",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Why the agent loop terminated.",
          "name": "finishReason",
          "required": true,
          "schema": {
            "enum": [
              "stop",
              "max_iterations",
              "cancelled",
              "retry_budget_exhausted",
              "consecutive_empty_responses"
            ],
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "The agent loop encountered an error.",
      "name": "agent/error",
      "params": [
        {
          "description": "Error message.",
          "name": "error",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Agent loop state transition.",
      "name": "state/change",
      "params": [
        {
          "description": "New state. One of: idle, thinking, awaiting_approval, executing_tool.",
          "name": "state",
          "required": true,
          "schema": {
            "enum": [
              "idle",
              "thinking",
              "awaiting_approval",
              "executing_tool"
            ],
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Streaming text chunk from the model's reply.",
      "name": "message/delta",
      "params": [
        {
          "description": "Text chunk.",
          "name": "delta",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Streaming reasoning/thinking chunk from the model (chain-of-thought).",
      "name": "reasoning/delta",
      "params": [
        {
          "description": "Reasoning text chunk.",
          "name": "delta",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Model requested a tool call.",
      "name": "tool/call",
      "params": [
        {
          "description": "Tool name.",
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Tool arguments as a JSON string.",
          "name": "arguments",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Tool execution completed.",
      "name": "tool/result",
      "params": [
        {
          "description": "Tool name.",
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Whether the tool returned an error.",
          "name": "is_error",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "description": "Tool output text.",
          "name": "output",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    {
      "description": "Tool call was denied by the approval gate.",
