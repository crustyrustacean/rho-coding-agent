    "PhaseTokenDistWire": {
      "description": "Wire-format phase token distribution (nested inside `getSessionStats`).\n\nShows how the live context is distributed across session phases, which\ntracks the shape of the work being done (exploration vs execution vs\nverification vs conclusion). Only meaningful once the session has\nclassified entries into phases; otherwise all buckets are zero.",
      "properties": {
        "conclusion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "execution": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exploration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verification": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "exploration",
        "execution",
        "verification",
        "conclusion",
        "unclassified"
      ],
      "type": "object"
    },
    "ProviderEntry": {
