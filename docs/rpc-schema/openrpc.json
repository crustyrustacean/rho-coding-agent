        "outlined",
        "summarized",
        "pinned"
      ],
      "type": "object"
    },
    "RoleTokenDist": {
      "description": "Wire-format role token distribution (nested inside `getSessionStats`).",
      "properties": {
        "assistant": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "system": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tool": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "user": {
          "format": "uint64",
          "minimum": 0,
